# App
APP_NAME=Contact API
APP_VERSION=1.0.0
DEBUG=false
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
TRUST_PROXY=false
MAX_REQUEST_BODY_BYTES=32768

# Data
DATA_DIR=./data

# Rate limit
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=3600

# Gmail SMTP (локально ок; на Railway порт 587 часто блокируют)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=your@gmail.com
OWNER_EMAIL=your@gmail.com

# Бесплатно: Gmail через Google Apps Script (см. scripts/gmail_email_webhook.gs)
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Mailjet (часто просит карту) — опционально
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_SENDER_EMAIL=your@gmail.com
MAILJET_SENDER_NAME=Contact API

# Brevo — часто ждёт активации SMTP у саппорта
BREVO_API_KEY=
BREVO_SENDER_EMAIL=your@gmail.com
BREVO_SENDER_NAME=Contact API

# Resend — опционально (без домена шлёт только на email аккаунта Resend)
RESEND_API_KEY=
RESEND_FROM=Contact API <onboarding@resend.dev>

# AI providers (достаточно одного — бесплатные: Groq или Gemini)
AI_PROVIDER=auto
AI_TIMEOUT_SECONDS=8

# Groq — бесплатно: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Gemini — бесплатно: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI — платно: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=5

# Metrics (обязательно в production)
METRICS_API_KEY=change-me-metrics-secret
