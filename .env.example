# App
APP_NAME=Dev Landing API
APP_VERSION=1.0.0
DEBUG=false
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://localhost:8001
TRUST_PROXY=true
MAX_REQUEST_BODY_BYTES=32768

# Data
DATA_DIR=./data

# Rate limit
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=3600

# Gmail SMTP (App Password: https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=your@gmail.com
OWNER_EMAIL=your@gmail.com

# AI providers (достаточно одного — бесплатные: Groq или Gemini)
AI_PROVIDER=auto
AI_TIMEOUT_SECONDS=8

# Groq — бесплатно: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Gemini — бесплатно: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI — платно: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=5

# Metrics (обязательно в production)
METRICS_API_KEY=change-me-metrics-secret
